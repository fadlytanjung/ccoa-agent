# ---- secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# ---- data (regenerated by app.seed) ----
# DeepEval writes local telemetry and cache state next to wherever it is run.
.deepeval/
.deepeval-cache.json
.deepeval_telemetry.txt
temp_test_run_data.json

# SQLite artefacts anywhere. Scoping this to backend/data/ let a stray database
# created from another working directory become a tracked file.
*.db
*.db-wal
*.db-shm
backend/.langgraph_api/

# ---- node ----
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# ---- test artefacts ----
# Playwright writes traces, videos, and failure screenshots per run; they are large,
# binary, and meaningless outside the run that produced them.
playwright-report/
test-results/
frontend/shot-*.png

# ---- terraform ----
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
.terraformrc
terraform.rc
# tfvars may contain account-specific values; envs/*.tfvars is checked in deliberately
# and must contain no secrets — see docs/10-security.md
*.auto.tfvars

# ---- editors / os ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
