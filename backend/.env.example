# Copy to .env and fill in. Committed; .env is not.
# Every variable the backend reads is listed here — docs/14-local-dev.md §3.3.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Model -----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Stable IDs only. gemini-3-flash exists solely as gemini-3-flash-preview, and a
# preview ID can be withdrawn — see docs/02 §3.1.
#   gemini-3.5-flash        default: cheapest stable model with strong tool calling
#   gemini-3.5-flash-lite   cheaper still; weaker at multi-step tool use
#   gemini-3.6-flash        previous default; more capable, more expensive
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Data ------------------------------------------------------------------
DB_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# CVE-2026-28277 mitigation. Required wherever a checkpointer runs; the process
# refuses to start with this disabled outside local development (docs/02 §4.2).
LANGGRAPH_STRICT_MSGPACK=true

# --- Features --------------------------------------------------------------
# Nice-to-have. Needs a vector-enabled image; degrades to keyword search (docs/13).
ENABLE_VECTOR_SEARCH=false

# --- Tracing ---------------------------------------------------------------
# Opt-in per environment. When true, prompts, tool results, and graph state are sent
# to LangSmith. Acceptable here only because all data is synthetic (docs/10 §6).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ccoa-local

# --- Identity --------------------------------------------------------------
# AUTH_MODE=dev substitutes a fixed actor holding both groups, so no Cognito pool is
# needed locally. The process refuses to start with it set when ENVIRONMENT is not
# local, so it cannot ship (docs/14 §3.7).
AUTH_MODE=dev
COGNITO_USER_POOL_ID=local-dev
COGNITO_CLIENT_ID=local-dev
COGNITO_REGION=ap-southeast-1
